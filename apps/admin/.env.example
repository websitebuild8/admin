# Copy to .env.local for local development. Never commit real credentials.
# Demo contains fictional records and never reads/writes Neon.
IGO_DEMO_MODE=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# Explicit server-owned admin allowlist. A Clerk account alone grants no access.
ADMIN_CLERK_USER_IDS=
# Neon pooled runtime URL and direct migration URL. Preserve sslmode=require.
DATABASE_URL=
DIRECT_URL=
