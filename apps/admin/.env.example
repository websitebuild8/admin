# Copy to .env.local only if no private local configuration exists.
# Keep all actual values outside Git and chat.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/delivery/sign-in
ADMIN_CLERK_USER_IDS=
# Optional additional protected super-admin IDs; only the operator configures these.
SUPER_ADMIN_CLERK_USER_IDS=
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternative to SUPABASE_SECRET_KEY: SUPABASE_SERVICE_ROLE_KEY
DELIVERY_PUBLIC_URL=http://localhost:3000
# Optional embedded rider directions. External Google Maps links need no API key.
GOOGLE_MAPS_EMBED_API_KEY=
# Optional background rider push; generate privately with npm run rider:keys.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
PUSH_CRON_SECRET=
