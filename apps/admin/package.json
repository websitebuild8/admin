{
  "name": "igo-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "prebuild": "prisma generate",
    "predev": "prisma generate",
    "db:status": "prisma migrate status",
    "photos:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-menu-images.ts",
    "photos:verify": "node --conditions=react-server --import tsx scripts/verify-menu-images.ts",
    "photos:verify-storage": "node --conditions=react-server --import tsx scripts/verify-menu-images-storage.ts",
    "delivery:verify": "node --import tsx scripts/setup-delivery.ts verify",
    "delivery:cron": "node --import tsx scripts/setup-delivery.ts cron",
    "delivery:storage": "node --import tsx scripts/setup-delivery.ts storage",
    "delivery:logo-storage": "node --conditions=react-server --import tsx scripts/setup-partner-logos.ts",
    "delivery:auth-check": "node --import tsx scripts/verify-partner-auth-config.ts",
    "delivery:verify-payouts": "node --import tsx scripts/verify-cod-receipt-ledger.ts",
    "rider:keys": "node --import tsx scripts/setup-rider-push.ts keys",
    "rider:cron": "node --import tsx scripts/setup-rider-push.ts cron",
    "rider:verify-cron": "node --import tsx scripts/setup-rider-push.ts verify-cron",
    "rider:enable-network": "node --import tsx scripts/setup-rider-push.ts enable-network",
    "rider:push-status": "node --import tsx scripts/setup-rider-push.ts status",
    "delivery:integration": "NODE_ENV=test node --conditions=react-server --import tsx scripts/verify-delivery-integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/backend": "^3.22.0",
    "@clerk/nextjs": "^7.9.10",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.5",
    "exceljs": "4.4.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "yauzl": "3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.10",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
