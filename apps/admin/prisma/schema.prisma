generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Seller delivery platform: Admin, Partner and Rider workspaces.
model DeliveryRequestBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  // Keep the physical name so the currently deployed forms continue to work
  // during the source deployment. Only delivery request counters remain here.
  @@index([expiresAt], map: "MapUsageBucket_expiresAt_idx")
  @@map("MapUsageBucket")
}

enum DeliveryRole {
  PARTNER
  DRIVER
}

enum DeliveryReview {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ParcelState {
  REGISTERED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum DeliveryPaymentState {
  PENDING
  REJECTED
  PARTIAL
  CONFIRMED
}

model DeliveryAccount {
  id          String                 @id @default(uuid()) @db.Uuid
  clerkUserId String
  role        DeliveryRole
  primary     Boolean                @default(true)
  status      DeliveryReview         @default(PENDING)
  name        String
  phone       String
  reviewNote  String                 @default("")
  reviewedBy  String?
  reviewedAt  DateTime?              @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  partner     DeliveryPartner?
  assigned    DeliveryParcel[]       @relation("AssignedDeliveryDriver")
  pushSubscriptions DeliveryPushSubscription[]
  @@unique([clerkUserId, role])
}

model DeliveryPartner {
  id            String                      @id @default(uuid()) @db.Uuid
  accountId     String                      @unique @db.Uuid
  account       DeliveryAccount             @relation(fields: [accountId], references: [id])
  businessName  String
  pageUrl       String
  pickupAddress String
  pickupArea    String
  operatingLocation String?
  cutoffMinutes Int                         @default(1080)
  nextInvoiceAt DateTime?                   @db.Timestamptz(3)
  parcels       DeliveryParcel[]
  invoices      DeliveryInvoice[]
  payments      DeliveryPayment[]
  imports       DeliveryImport[]
  receipts      DeliveryReceipt[]
  cycles        DeliveryBillingCycle[]
  applicationId String?                     @unique @db.Uuid
  application   DeliveryPartnerApplication? @relation(fields: [applicationId], references: [id])
}

// Public applications are not login accounts. Identity is linked only after
// admin approval and proof of ownership of the application's email address.
model DeliveryPartnerApplication {
  id                  String           @id @default(uuid()) @db.Uuid
  publicId            String           @unique
  requestKey          String           @unique @db.Uuid
  digest              String
  email               String           @unique
  ownerName           String
  phone               String
  businessName        String
  businessType        String
  pageUrl             String
  pickupAddress       String
  pickupArea          String
  operatingLocation   String?
  dailyDeliveries     Int
  logoPath            String?
  submittedAt         DateTime?        @db.Timestamptz(3)
  logoReady           Boolean          @default(false)
  status              DeliveryReview   @default(PENDING)
  reviewNote          String           @default("")
  reviewedBy          String?
  reviewedAt          DateTime?        @db.Timestamptz(3)
  invitationId        String?          @unique
  invitationState     String           @default("NOT_SENT")
  invitationLease     String?          @db.Uuid
  invitationStartedAt DateTime?        @db.Timestamptz(3)
  invitationSentAt    DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  partner             DeliveryPartner?

  @@index([status, createdAt])
}

model DeliveryDestination {
  code String @id
  label String
  active Boolean @default(true)
  rates DeliveryRate[]
  parcels DeliveryParcel[]
}

model DeliveryRate {
  origin String
  zone String
  destination DeliveryDestination @relation(fields: [zone], references: [code])
  fee Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@id([origin, zone])
}

model DeliveryParcel {
  id                String                 @id @default(uuid()) @db.Uuid
  publicId          String                 @unique
  partnerId         String                 @db.Uuid
  partner           DeliveryPartner        @relation(fields: [partnerId], references: [id])
  externalReference String
  recipientName     String
  recipientPhone    String
  destination       String
  zone              String
  destinationZone   DeliveryDestination @relation(fields: [zone], references: [code])
  destinationLabel  String
  origin            String?
  description       String                 @default("")
  fee               Int
  state             ParcelState            @default(REGISTERED)
  driverId          String?                @db.Uuid
  driver            DeliveryAccount?       @relation("AssignedDeliveryDriver", fields: [driverId], references: [id])
  registeredAt      DateTime               @default(now()) @db.Timestamptz(3)
  pickedUpAt        DateTime?              @db.Timestamptz(3)
  pickedUpBy        String?
  deliveredAt       DateTime?              @db.Timestamptz(3)
  deliveredBy       String?
  importId          String?                @db.Uuid
  batch             DeliveryImport?        @relation(fields: [importId], references: [id])
  invoiceLine       DeliveryInvoiceLine?

  @@unique([partnerId, externalReference])
  @@index([partnerId, registeredAt])
  @@index([driverId, state, registeredAt])
  @@index([partnerId, state, deliveredAt])
}

model DeliveryImport {
  id        String           @id @default(uuid()) @db.Uuid
  partnerId String           @db.Uuid
  partner   DeliveryPartner  @relation(fields: [partnerId], references: [id])
  fileHash  String
  rowCount  Int
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  parcels   DeliveryParcel[]

  @@unique([partnerId, fileHash])
}

model DeliveryBillingCycle {
  id          String           @id @default(uuid()) @db.Uuid
  partnerId   String           @db.Uuid
  partner     DeliveryPartner  @relation(fields: [partnerId], references: [id])
  localDate   String
  cutoffAt    DateTime         @db.Timestamptz(3)
  processedAt DateTime         @default(now()) @db.Timestamptz(3)
  invoice     DeliveryInvoice?

  @@unique([partnerId, localDate])
}

model DeliveryInvoice {
  id             String                      @id @default(uuid()) @db.Uuid
  publicId       String                      @unique
  partnerId      String                      @db.Uuid
  partner        DeliveryPartner             @relation(fields: [partnerId], references: [id])
  cycleId        String?                     @unique @db.Uuid
  cycle          DeliveryBillingCycle?       @relation(fields: [cycleId], references: [id])
  manualCutoffAt DateTime?                   @db.Timestamptz(3)
  total          Int
  paid           Int                         @default(0)
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  lines          DeliveryInvoiceLine[]
  payments       DeliveryPayment[]
  allocations    DeliveryPaymentAllocation[]
  dispatch       DeliveryInvoiceDispatch?
  paidInvoice    DeliveryPaidInvoice?
  events         DeliveryInvoiceEvent[]

  @@index([partnerId, createdAt])
}

model DeliveryInvoiceLine {
  id        String          @id @default(uuid()) @db.Uuid
  invoiceId String          @db.Uuid
  invoice   DeliveryInvoice @relation(fields: [invoiceId], references: [id])
  parcelId  String          @unique @db.Uuid
  parcel    DeliveryParcel  @relation(fields: [parcelId], references: [id])
  amount    Int
}

model DeliveryReceipt {
  id        String           @id @default(uuid()) @db.Uuid
  partnerId String           @db.Uuid
  partner   DeliveryPartner  @relation(fields: [partnerId], references: [id])
  path      String           @unique
  sha256    String
  bytes     Int
  ready     Boolean          @default(false)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  payment   DeliveryPayment?

  @@unique([partnerId, sha256])
}

model DeliveryPayment {
  id              String                     @id @default(uuid()) @db.Uuid
  partnerId       String                     @db.Uuid
  partner         DeliveryPartner            @relation(fields: [partnerId], references: [id])
  invoiceId       String                     @db.Uuid
  invoice         DeliveryInvoice            @relation(fields: [invoiceId], references: [id])
  receiptId       String                     @unique @db.Uuid
  receipt         DeliveryReceipt            @relation(fields: [receiptId], references: [id])
  bankReference   String                     @unique
  amount          Int
  confirmedAmount Int                        @default(0)
  status          DeliveryPaymentState       @default(PENDING)
  reviewNote      String                     @default("")
  reviewedBy      String?
  reviewedAt      DateTime?                  @db.Timestamptz(3)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  allocation      DeliveryPaymentAllocation?

  @@index([partnerId, createdAt])
}

model DeliveryPaymentAllocation {
  id        String          @id @default(uuid()) @db.Uuid
  paymentId String          @unique @db.Uuid
  payment   DeliveryPayment @relation(fields: [paymentId], references: [id])
  invoiceId String          @db.Uuid
  invoice   DeliveryInvoice @relation(fields: [invoiceId], references: [id])
  amount    Int
}

model DeliveryCommand {
  id        String   @id
  hash      String
  response  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  subjects String[] @default([])
  invalidated Boolean @default(false)
}

// A transaction-bound permit and permanent, minimal deletion audit. It contains
// IDs/counts, never copies of deleted profiles, receipts or invoice documents.
model DeliveryDeletion {
  id String @id @db.Uuid
  actor String
  kind String
  targetId String @db.Uuid
  reason String
  manifest Json
  transactionId BigInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// Durable outbox: rows disappear only after Supabase confirms object removal.
model DeliveryDeletedFile {
  id String @id @default(uuid()) @db.Uuid
  deletionId String @db.Uuid
  bucket String
  path String
  attempts Int @default(0)
  lastError String @default("")
  notBefore DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([bucket, path])
}

model DeliveryActivity {
  id        String   @id @default(uuid()) @db.Uuid
  actor     String
  role      String
  kind      String
  partnerId String?  @db.Uuid
  entityId  String?
  detail    Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([partnerId, createdAt])
}

model DeliveryNotification {
  id              String                   @id @default(uuid()) @db.Uuid
  recipient       String
  workspace       String                   @default("ACCOUNT")
  title           String
  message         String
  readAt          DateTime?                @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  pushMessages    DeliveryPushMessage[]
  invoiceDispatch DeliveryInvoiceDispatch?
  paidInvoiceDispatch DeliveryPaidInvoiceDispatch?

  @@index([recipient, createdAt])
}

model DeliveryInvoiceDispatch {
  invoiceId      String               @id @db.Uuid
  invoice        DeliveryInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  notificationId String?              @unique @db.Uuid
  notification   DeliveryNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  sentBy         String
  sentAt         DateTime             @default(now()) @db.Timestamptz(3)
}

model DeliveryPushSubscription {
  id String @id @default(uuid()) @db.Uuid
  driverId String @db.Uuid
  driver DeliveryAccount @relation(fields: [driverId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  messages DeliveryPushMessage[]
  @@index([driverId])
}

model DeliveryPushMessage {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @db.Uuid
  notification DeliveryNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String @db.Uuid
  subscription DeliveryPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  state String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([notificationId, subscriptionId])
  @@index([state, nextAttemptAt, leaseUntil])
}

model DeliverySettings {
  id                 String   @id @default("default")
  bankName           String   @default("")
  bankAccount        String   @default("")
  beneficiary        String   @default("")
  businessLegalName  String   @default("")
  registrationNumber String   @default("")
  supportPhone       String   @default("")
  supportEmail       String   @default("")
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model DeliveryPaidInvoice {
  invoiceId String @id @db.Uuid
  invoice DeliveryInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  snapshot Json
  paidAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  dispatch DeliveryPaidInvoiceDispatch?
}

model DeliveryPaidInvoiceDispatch {
  invoiceId String @id @db.Uuid
  paidInvoice DeliveryPaidInvoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Restrict)
  notificationId String? @unique @db.Uuid
  notification DeliveryNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  sentBy String
  sentAt DateTime @default(now()) @db.Timestamptz(3)
}

model DeliveryInvoiceEvent {
  id String @id
  invoiceId String @db.Uuid
  invoice DeliveryInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  kind String
  occurredAt DateTime @db.Timestamptz(3)
  amount Int?
  reference String @default("")
  note String @default("")
  receiptId String? @db.Uuid

  @@index([invoiceId, occurredAt, id])
}

// Separate privileges preserve the account's approved partner/rider identity.
model DeliveryAdminGrant {
  id String @id @default(uuid()) @db.Uuid
  clerkUserId String @unique
  email String
  name String
  active Boolean @default(true)
  grantedBy String
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  revokedBy String?
  revokedAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([active, grantedAt])
}
