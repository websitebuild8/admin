generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String @id @default(uuid())
  clerkUserId String @unique
  name        String
  createdAt   DateTime @default(now())
  roles       RoleApplication[]
  primaryRole String?
  phone       String?
  addresses   SavedAddress[]
  consents    PolicyAcceptance[]
}

model RoleApplication {
  id          String @id @default(uuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id])
  role        String
  status      String @default("Pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  details     Json?
  @@unique([profileId, role])
}

model Restaurant {
  clerkUserId       String? @unique
  location          Json?
  id                String @id @default(uuid())
  name              String
  initials          String
  cuisine           String
  area              String
  contact           String
  status            String @default("Pending")
  prepTime          Int @default(20)
  color             String @default("coffee")
  documentsVerified Boolean @default(false)
  acceptingOrders   Boolean @default(false)
  orders            Order[]
  menu              MenuItem[]
  pickupAddress     Json?
  pendingPickupAddress Json?
}

model Rider {
  clerkUserId       String? @unique
  location          Json?
  id                String @id @default(uuid())
  name              String
  initials          String
  area              String
  phone             String
  status            String @default("Pending")
  online            Boolean @default(false)
  deliveries        Int @default(0)
  documentsVerified Boolean @default(false)
  orders            Order[]
}

model Order {
  publicId      String? @unique
  pickupAddress Json?
  addressSnapshot Json?
  lineItems     Json?
  workflow      Json?
  destination   Json?
  id            String @id @default(uuid())
  customerId    String
  customer      String
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  items         String
  amount        Int
  area          String
  address       String
  status        String @default("Awaiting restaurant")
  riderId       String?
  rider         Rider? @relation(fields: [riderId], references: [id])
  time          DateTime @default(now())
  paid          Boolean @default(false)
  paymentRef    String @unique
  refunds       RefundReview[]
  tickets       SupportCase[]
  @@index([status, time])
}

model SavedAddress {
  google       Json?
  id           String @id @default(uuid())
  profileId    String
  profile      Profile @relation(fields: [profileId], references: [id])
  kind         String
  area         String
  building     String
  unit         String @default("")
  instructions String @default("")
  latitude     Float
  longitude    Float
  updatedAt    DateTime @updatedAt
  @@unique([profileId, kind])
}

model MapUsageBucket {
  key       String @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model MenuItem {
  id           String @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String
  price        Int
  available    Boolean @default(true)
  updatedAt    DateTime @updatedAt
  @@index([restaurantId, available])
}

model PolicyAcceptance {
  id           String @id @default(uuid())
  profileId    String
  profile      Profile @relation(fields: [profileId], references: [id])
  version      String
  acceptedAt   DateTime @default(now())
  @@unique([profileId, version])
}

model CheckoutQuote {
  id           String @id @default(uuid())
  customerId   String
  restaurantId String
  snapshot     Json
  amount       Int
  currency     String @default("MVR")
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  attempt      PaymentAttempt?
  @@index([customerId, createdAt])
}

model PaymentAttempt {
  id           String @id @default(uuid())
  quoteId      String @unique
  quote        CheckoutQuote @relation(fields: [quoteId], references: [id])
  transactionId String? @unique
  status       String @default("Created")
  checkoutUrl  String?
  orderId      String? @unique
  createdAt    DateTime @default(now())
  verifiedAt   DateTime?
}

model RefundReview {
  id       String @id @default(uuid())
  orderId  String
  order    Order @relation(fields: [orderId], references: [id])
  amount   Int
  reason   String
  status   String @default("Requested")
  time     DateTime @default(now())
}

model SupportCase {
  id       String @id @default(uuid())
  orderId  String
  order    Order @relation(fields: [orderId], references: [id])
  subject  String
  customer String
  priority String @default("Normal")
  status   String @default("Open")
}

model AuditEvent {
  id    String @id @default(uuid())
  text  String
  actor String
  time  DateTime @default(now())
}

model ServiceSettings {
  id               String @id @default("default")
  businessName     String @default("iGO")
  supportEmail     String @default("")
  deliveryFee      Int @default(2500)
  maleEnabled      Boolean @default(true)
  hulhumaleEnabled Boolean @default(true)
}

model Notification {
  id String @id
  orderId String
  recipient String
  text String
  time DateTime @default(now())
  @@index([recipient, time])
}
